<Window x:Class="DanzFlyout.VolumeFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VolumeFlyout"
        Height="118" Width="352"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Opacity="0">

    <!-- Outer margin (28) is room for the soft shadow so it never gets cut into a hard bar -->
    <Grid Margin="28">
        <Border x:Name="FlyoutCard"
                CornerRadius="31"
                BorderThickness="1">

            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#80FFFFFF" Offset="0.0"/>
                    <GradientStop Color="#24FFFFFF" Offset="0.45"/>
                    <GradientStop Color="#58FFFFFF" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#B523252D" Offset="0.0"/>
                    <GradientStop Color="#A01A1C23" Offset="0.5"/>
                    <GradientStop Color="#B0202229" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>


            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="#000000" Opacity="0.42" Direction="270" ShadowDepth="6"/>
            </Border.Effect>

            <Grid>
                <!-- Top sheen -->
                <Border Height="1" VerticalAlignment="Top" Margin="26,0" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                            <GradientStop Color="#65FFFFFF" Offset="0.5"/>
                            <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid Margin="24,0,22,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="56"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtVolIcon"
                               Grid.Column="0"
                               Text="&#xE995;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="19"
                               Width="26"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0"/>

                    <Grid x:Name="SliderTrackContainer"
                          Grid.Column="1"
                          Height="8"
                          Margin="0,0,16,0"
                          VerticalAlignment="Center">

                        
                    <Border CornerRadius="4"
                        BorderBrush="#35FFFFFF"
                        BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#35101013" Offset="0"/>
                            <GradientStop Color="#20101013" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>


                        <Border x:Name="VolFill"
                            HorizontalAlignment="Left"
                            Width="60"
                            CornerRadius="4">

                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF777777" Offset="0.0"/>
                                <GradientStop Color="#FFD0D0D0" Offset="0.65"/>
                                <GradientStop Color="#FFFFFFFF" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="8"
                                Color="#FFFFFF"
                                Opacity="0.20"
                                ShadowDepth="0"/>
                        </Border.Effect>

                        <!-- Knob riding the end of the fill -->
                        <Ellipse x:Name="VolKnob"
                                Width="16"
                                Height="16"
                                Stroke="#DFFFFFFF"
                                StrokeThickness="0.8"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,-8,0">

                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFE0E0E4" Offset="0"/>
                                    <GradientStop Color="#FFC5C6CC" Offset="0.55"/>
                                    <GradientStop Color="#FF999CA5" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>

                        </Ellipse>
                    </Border>
                    </Grid>

                    <TextBlock x:Name="TxtVolume"
                               Grid.Column="2"
                               Text="50%"
                               FontSize="14"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
