<Window x:Class="DanzFlyout.VolumeFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VolumeFlyout"
        Height="118" Width="352"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Opacity="0">

    <!-- Outer margin (28) is room for the soft shadow so it never gets cut into a hard bar -->
    <Grid Margin="28">
        <Border x:Name="FlyoutCard"
                CornerRadius="31"
                BorderThickness="1">

            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#50FFFFFF" Offset="0.0"/>
                    <GradientStop Color="#18FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#2C8C9CFF" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <!-- Near-opaque so the shadow can't show through the card -->
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F21B1E29" Offset="0.0"/>
                    <GradientStop Color="#F2121520" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>

            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="#000000" Opacity="0.42" Direction="270" ShadowDepth="6"/>
            </Border.Effect>

            <Grid>
                <!-- Top sheen -->
                <Border Height="1" VerticalAlignment="Top" Margin="26,0" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                            <GradientStop Color="#40FFFFFF" Offset="0.5"/>
                            <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid Margin="24,0,22,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="56"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtVolIcon"
                               Grid.Column="0"
                               Text="&#xE995;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="19"
                               Width="26"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0"/>

                    <Grid x:Name="SliderTrackContainer"
                          Grid.Column="1"
                          Height="8"
                          Margin="0,0,16,0"
                          VerticalAlignment="Center">

                        <Border Background="#26FFFFFF" CornerRadius="4"/>

                        <Border x:Name="VolFill"
                                HorizontalAlignment="Left"
                                Width="60"
                                CornerRadius="4">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFB8C4FF" Offset="0.0"/>
                                    <GradientStop Color="#FFFFFFFF" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Color="#8C9CFF" Opacity="0.45" ShadowDepth="0"/>
                            </Border.Effect>

                            <!-- Knob riding the end of the fill -->
                            <Ellipse x:Name="VolKnob"
                                     Width="14" Height="14"
                                     Fill="#FFFFFF"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center"
                                     Margin="0,0,-7,0"/>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="TxtVolume"
                               Grid.Column="2"
                               Text="50%"
                               FontSize="14"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
