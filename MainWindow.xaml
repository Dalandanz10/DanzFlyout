<Window x:Class="DanzFlyout.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DanzFlyout"
        Height="100"
        Width="330"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Opacity="0"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        MouseRightButtonUp="Window_MouseRightButtonUp">

    <Window.Resources>
        <Style x:Key="MediaControlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="8">

        <!-- Smooth entrance / exit -->
        <Grid.RenderTransform>
            <TranslateTransform x:Name="CardTranslate" Y="12"/>
        </Grid.RenderTransform>

        <!-- Main Card -->
        <Border x:Name="CardBorder"
                CornerRadius="18"
                ClipToBounds="True"
                BorderThickness="1">

            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#38FFFFFF" Offset="0"/>
                    <GradientStop Color="#12FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#24FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Border.Background>
                <SolidColorBrush Color="#E6101116"/>
            </Border.Background>

            <Grid>

                <!-- Very subtle adaptive glow -->
                <Border x:Name="AccentOverlayBorder"
                        CornerRadius="18"
                        Opacity="0"
                        Background="#257C8CFF"/>

                <!-- Content -->
                <Grid x:Name="MeltContainer"
                      Margin="10,9,10,9">

                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="MeltScale"
                                            ScaleX="1"
                                            ScaleY="1"/>
                            <TranslateTransform x:Name="MeltTranslate"
                                                X="0"
                                                Y="0"/>
                        </TransformGroup>
                    </Grid.RenderTransform>

                    <Grid.Effect>
                        <BlurEffect x:Name="MeltBlur"
                                    Radius="0"/>
                    </Grid.Effect>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- ALBUM ART -->
                    <Border Grid.Column="0"
                            Width="56"
                            Height="56"
                            CornerRadius="11"
                            ClipToBounds="True"
                            Background="#18FFFFFF"
                            VerticalAlignment="Center">

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12"
                                              ShadowDepth="0"
                                              Opacity="0.35"/>
                        </Border.Effect>

                        <Image x:Name="AlbumCover"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <ScaleTransform x:Name="AlbumCoverTrackScale" ScaleX="1" ScaleY="1"/>
                            </Image.RenderTransform>
                        </Image>
                    </Border>

                    <!-- TRACK INFO -->
                    <Grid Grid.Column="1"
                          Margin="11,0,9,0"
                          VerticalAlignment="Center">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- TITLE -->
                        <Canvas x:Name="TitleCanvas"
                                Grid.Row="0"
                                Height="22"
                                ClipToBounds="True">

                            <TextBlock x:Name="TrackTitle"
                                       Text="No media playing"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       Foreground="#FFFFFF"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="TitleTrackTranslate" X="0" Y="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Canvas>

                        <!-- ARTIST -->
                        <Canvas x:Name="ArtistCanvas"
                                Grid.Row="1"
                                Height="18"
                                Margin="0,1,0,0"
                                ClipToBounds="True">

                            <TextBlock x:Name="TrackArtist"
                                       Text=""
                                       FontSize="11"
                                       FontWeight="Normal"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       Foreground="#9FA4B2">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="ArtistTranslate" X="0" Y="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Canvas>

                    </Grid>

                    <!-- CONTROLS -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <!-- PREVIOUS -->
                        <Button x:Name="BtnPrev"
                                Style="{StaticResource MediaControlButton}"
                                Click="BtnPrev_Click"
                                Width="28"
                                Height="30"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">

                            <Path Data="M 11,3 L 4,8 L 11,13 Z M 3,3 L 1,3 L 1,13 L 3,13 Z"
                                  Fill="#C8CBD3"
                                  Stretch="Uniform"
                                  Width="10"
                                  Height="10"/>
                        </Button>

                        <!-- PLAY / PAUSE -->
                        <Button x:Name="BtnPlayPause"
                                Style="{StaticResource MediaControlButton}"
                                Click="BtnPlayPause_Click"
                                Width="32"
                                Height="32"
                                Margin="1,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">

                            <Border Width="28"
                                    Height="28"
                                    CornerRadius="14"
                                    Background="#247C8CFF">

                                <Path x:Name="PlayPauseIcon"
                                      Data="M 3,3 L 6,3 L 6,15 L 3,15 Z M 10,3 L 13,3 L 13,15 L 10,15 Z"
                                      Fill="#FFFFFF"
                                      Stretch="Uniform"
                                      Width="11"
                                      Height="11"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                        </Button>

                        <!-- NEXT -->
                        <Button x:Name="BtnNext"
                                Style="{StaticResource MediaControlButton}"
                                Click="BtnNext_Click"
                                Width="28"
                                Height="30"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">

                            <Path Data="M 1,3 L 8,8 L 1,13 Z M 9,3 L 11,3 L 11,13 L 9,13 Z"
                                  Fill="#C8CBD3"
                                  Stretch="Uniform"
                                  Width="10"
                                  Height="10"/>
                        </Button>

                    </StackPanel>

                </Grid>

                <!-- Tiny bottom accent -->
                <Border Height="2"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Stretch"
                        Margin="18,0"
                        CornerRadius="1"
                        Background="#407C8CFF"
                        Opacity="0.7"/>

            </Grid>

        </Border>

    </Grid>

</Window>