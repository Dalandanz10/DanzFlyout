<Window x:Class="DanzFlyout.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DanzFlyout Settings"
        Icon="Assets/DanzFlyout.ico"
        Height="730" Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- DanzFlyout Settings Theme -->
<SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F00C0E14"/>
<SolidColorBrush x:Key="PanelBackgroundBrush" Color="#141820"/>
<SolidColorBrush x:Key="CardBackgroundBrush" Color="#101820"/>
<SolidColorBrush x:Key="CardBorderBrush" Color="#20FFFFFF"/>

<SolidColorBrush x:Key="AccentBrush" Color="#7C8CFF"/>
<SolidColorBrush x:Key="AccentHoverBrush" Color="#A5B0FF"/>
<SolidColorBrush x:Key="AccentMutedBrush" Color="#267C8CFF"/>

<SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF"/>
<SolidColorBrush x:Key="SecondaryTextBrush" Color="#AAB1C2"/>
<SolidColorBrush x:Key="MutedTextBrush" Color="#78FFFFFF"/>
<SolidColorBrush x:Key="SuccessBrush" Color="#5EEAD4"/>
        <!-- ========= Thin modern scrollbars ========= -->
        <Style x:Key="ScrollTrackBtn" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumb" Background="#3AFFFFFF" CornerRadius="4" Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="#807C8CFF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="#7C8CFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollTrackBtn}" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollTrackBtn}" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollTrackBtn}" Command="ScrollBar.PageLeftCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollTrackBtn}" Command="ScrollBar.PageRightCommand"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ========= Slider ========= -->
        <Style x:Key="SliderFillBtn" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#5E6EE8" Offset="0"/>
                                    <GradientStop Color="#7C8CFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="knob" Background="#FFFFFF" CornerRadius="8" BorderBrush="#7C8CFF" BorderThickness="2">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#7C8CFF" Opacity="0.45"/>
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="knob" Property="BorderBrush" Value="#B4BEFF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="knob" Property="Background" Value="#E4E8FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent" Height="24">
                            <Border Height="4" CornerRadius="2" Background="#26FFFFFF" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderFillBtn}" Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollTrackBtn}" Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========= Rounded buttons / text boxes ========= -->
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="SelectionBrush" Value="#7C8CFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#7C8CFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#0BFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="12" Padding="16,0" Margin="5">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#16FFFFFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#487C8CFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========= Text / card styles ========= -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        </Style>

        <Style x:Key="PageSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Margin" Value="0,3,0,16"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="2,12,0,8"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style x:Key="RowDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#78FFFFFF"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <ControlTemplate x:Key="DarkComboBoxTemplate" TargetType="ComboBox">
            <Grid SnapsToDevicePixels="True">
                <ToggleButton x:Name="DropDownToggle"
                              Focusable="False"
                              IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              ClickMode="Press">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="RootBorder"
                                    Background="#1A1E28"
                                    BorderBrush="#38FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="Arrow"
                                          Grid.Column="1"
                                          Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="#AEB6C8"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RootBorder" Property="Background" Value="#242A38"/>
                                    <Setter TargetName="RootBorder" Property="BorderBrush" Value="#705EEAD4"/>
                                    <Setter TargetName="Arrow" Property="Fill" Value="#7C8CFF"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="RootBorder" Property="Background" Value="#151820"/>
                                    <Setter TargetName="RootBorder" Property="BorderBrush" Value="#7C8CFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <ContentPresenter IsHitTestVisible="False"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  Margin="12,0,28,0"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="FontSize" Value="12.5"/>
                            <Setter Property="FontWeight" Value="Medium"/>
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <Popup x:Name="PART_Popup"
                       AllowsTransparency="True"
                       Focusable="False"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       Placement="Bottom"
                       PopupAnimation="Fade">
                    <Border Background="#151820"
                            BorderBrush="#32FFFFFF"
                            BorderThickness="1"
                            CornerRadius="7"
                            MinWidth="{TemplateBinding ActualWidth}"
                            MaxHeight="220"
                            Margin="0,3,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Color="#000000" Opacity="0.5" Direction="270" ShadowDepth="4"/>
                        </Border.Effect>
                        <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Template" Value="{StaticResource DarkComboBoxTemplate}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Margin="2,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#307C8CFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#257C8CFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RailBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Width" Value="132"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#01000000" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#20FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#01000000">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F00C0E14"
        BorderBrush="#18FFFFFF"
        BorderThickness="1"
        CornerRadius="18"
        ClipToBounds="True">

        <Grid>
            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="154"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT RAIL -->
                <Border Grid.Column="0" Background="#12000000" BorderBrush="#18FFFFFF" BorderThickness="0,0,1,0" CornerRadius="16,0,0,16">
                    <Grid Margin="0,14,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- APP LOGO CONTAINER -->
                        <Border Grid.Row="0"
                                Width="38" Height="38"
                                CornerRadius="11"
                                Background="#181A24"
                                BorderBrush="#25FFFFFF"
                                BorderThickness="1"
                                ClipToBounds="True"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,4,0,22">
                            <Image Source="pack://application:,,,/Assets/DanzFlyout.ico"
                                   Width="28" Height="28"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                        <Grid Margin="0,0,0,6">
                            <Border x:Name="IndHome" Width="3" Height="30" Background="#7C8CFF" HorizontalAlignment="Left" CornerRadius="2" Visibility="Visible"/>
                            <Button Click="NavHome_Click" ToolTip="Dashboard" Style="{StaticResource RailBtn}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#FFFFFF" Width="28" TextAlignment="Center"/>
                                    <TextBlock Text="Dashboard" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Border x:Name="IndVis" Width="3" Height="30" Background="#7C8CFF" HorizontalAlignment="Left" CornerRadius="2" Visibility="Collapsed"/>
                            <Button Click="NavVisualizer_Click" ToolTip="Visualizer" Style="{StaticResource RailBtn}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="◈" FontSize="15" Foreground="#AAB1C2" Width="28" TextAlignment="Center"/>
                                    <TextBlock Text="Visualizer" FontSize="12" Foreground="#AAB1C2" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Border x:Name="IndMedia" Width="3" Height="30" Background="#7C8CFF" HorizontalAlignment="Left" CornerRadius="2" Visibility="Collapsed"/>
                            <Button Click="NavMedia_Click" ToolTip="Media Flyout" Style="{StaticResource RailBtn}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="♪" FontSize="17" Foreground="#AAB1C2" Width="28" TextAlignment="Center"/>
                                    <TextBlock Text="Media" FontSize="12" Foreground="#AAB1C2" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Border x:Name="IndVol" Width="3" Height="30" Background="#7C8CFF" HorizontalAlignment="Left" CornerRadius="2" Visibility="Collapsed"/>
                            <Button Click="NavVolume_Click" ToolTip="Volume Flyout" Style="{StaticResource RailBtn}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#AAB1C2" Width="28" TextAlignment="Center"/>
                                    <TextBlock Text="Volume" FontSize="12" Foreground="#AAB1C2" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Border x:Name="IndLock" Width="3" Height="30" Background="#7C8CFF" HorizontalAlignment="Left" CornerRadius="2" Visibility="Collapsed"/>
                            <Button Click="NavLock_Click" ToolTip="Lock Keys Flyout" Style="{StaticResource RailBtn}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#AAB1C2" Width="28" TextAlignment="Center"/>
                                    <TextBlock Text="Lock Keys" FontSize="12" Foreground="#AAB1C2" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Border x:Name="IndMixer" Width="3" Height="30" Background="#7C8CFF" HorizontalAlignment="Left" CornerRadius="2" Visibility="Collapsed"/>
                            <Button Click="NavMixer_Click" ToolTip="Mixer" Style="{StaticResource RailBtn}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="≋" FontSize="16" Foreground="#AAB1C2" Width="28" TextAlignment="Center"/>
                                    <TextBlock Text="Mixer" FontSize="12" Foreground="#AAB1C2" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Border x:Name="IndSys" Width="3" Height="30" Background="#7C8CFF" HorizontalAlignment="Left" CornerRadius="2" Visibility="Collapsed"/>
                            <Button Click="NavSystem_Click" ToolTip="System" Style="{StaticResource RailBtn}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#AAB1C2" Width="28" TextAlignment="Center"/>
                                    <TextBlock Text="System" FontSize="12" Foreground="#AAB1C2" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- MAIN CONTENT -->
                <Grid Grid.Column="1" Margin="34,24,26,26">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- TOP BAR -->
                    <Grid Grid.Row="0" Margin="0,0,0,14" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="DanzFlyout"
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Foreground="#FFFFFF"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Click="Minimize_Click" Width="32" Height="32" Style="{StaticResource HeaderBtn}">
                                <TextBlock Text="—" Foreground="#AAB1C2" FontSize="12"/>
                            </Button>
                            <Button Click="Close_Click" Width="32" Height="32" Style="{StaticResource HeaderBtn}">
                                <TextBlock Text="✕" Foreground="#AAB1C2" FontSize="13"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    
                    <!-- BODY VIEWS -->
                    <!-- DASHBOARD -->
                    <ScrollViewer x:Name="ViewDashboard" Grid.Row="1" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="A quick overview of your DanzFlyout features." Style="{StaticResource PageSub}"/>

                            <TextBlock Text="FEATURE STATUS" Style="{StaticResource SectionLabel}"/>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Taskbar Visualizer" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Mini album art, track title and audio bars." Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="StatVis" Grid.Column="1" Text="Enabled" VerticalAlignment="Center" Foreground="#5EEAD4" FontSize="12" FontWeight="SemiBold"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
