                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Start DanzFlyout with Windows" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Runs automatically in the system tray when you sign in." Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Click="ToggleAutoStart_Click" Style="{StaticResource HeaderBtn}">
                                        <Border x:Name="ToggleAutoPill" CornerRadius="11" Width="42" Height="22" Background="#18FFFFFF" BorderBrush="#32FFFFFF" BorderThickness="1">
                                            <Border CornerRadius="7" Width="14" Height="14" Background="#FFFFFF" HorizontalAlignment="Left" Margin="3,0"/>
                                        </Border>
                                    </Button>
                                </Grid>
                            </Border>
                            <TextBlock Text="WINDOWS INTEGRATION" Style="{StaticResource SectionLabel}"/>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Hide Windows Media Flyout" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Hides the native Windows media popup while keeping media-key integration active." Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Click="ToggleNativeMediaFlyout_Click" Style="{StaticResource HeaderBtn}">
                                        <Border x:Name="ToggleNativeMediaPill" CornerRadius="11" Width="42" Height="22" Background="#18FFFFFF" BorderBrush="#32FFFFFF" BorderThickness="1">
                                            <Border CornerRadius="7" Width="14" Height="14" Background="#FFFFFF" HorizontalAlignment="Left" Margin="3,0"/>
                                        </Border>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
    </Border>
</Window>
