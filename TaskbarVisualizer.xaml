
<Window x:Class="DanzFlyout.TaskbarVisualizer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DanzFlyout Visualizer"
        Height="40"
        Width="370"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Focusable="False">

    <Window.Resources>
        <!-- Compact, transparent media buttons with no default focus box -->
        <Style x:Key="TaskbarMediaButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Width" Value="21"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,1,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F2FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="HoverSurface"
                                Background="Transparent"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverSurface"
                                        Property="Background"
                                        Value="#20FFFFFF"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverSurface"
                                        Property="Background"
                                        Value="#35FFFFFF"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Margin="4,0,0,0">

            <!-- Previous / Play-Pause / Next -->
            
    <StackPanel x:Name="TaskbarMediaControls"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Height="28"
                Margin="0,0,6,0">

        <Button x:Name="TaskbarPreviousButton"
                Style="{StaticResource TaskbarMediaButtonStyle}"
                Width="24"
                Height="28"
                Margin="0,0,2,0"
                VerticalAlignment="Center"
                ToolTip="Previous track"
                Click="TaskbarPreviousButton_Click">
            <Viewbox Width="14"
                    Height="14"
                    Stretch="Uniform">
                <Canvas Width="16" Height="16">
                    <Path Fill="{Binding Foreground,
                        RelativeSource={RelativeSource AncestorType=Button}}"
                        Data="M 3,3 L 5,3 L 5,13 L 3,13 Z M 13,3 L 5,8 L 13,13 Z"/>
                </Canvas>
            </Viewbox>
        </Button>

        <Button x:Name="TaskbarPlayPauseButton"
                Style="{StaticResource TaskbarMediaButtonStyle}"
                Width="24"
                Height="28"
                Margin="0,0,2,0"
                VerticalAlignment="Center"
                ToolTip="Play or pause"
                Click="TaskbarPlayPauseButton_Click">
            <Viewbox Width="13"
                Height="13"
                Stretch="Uniform"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="-2,0,0,0">
            <Path x:Name="TaskbarPlayPauseIcon"
                Fill="{Binding Foreground,
                    RelativeSource={RelativeSource AncestorType=Button}}"
                Data="M 3,3 L 6,3 L 6,13 L 3,13 Z M 10,3 L 13,3 L 13,13 L 10,13 Z"/>
            </Viewbox>
        </Button>

        <Button x:Name="TaskbarNextButton"
                Style="{StaticResource TaskbarMediaButtonStyle}"
                Width="24"
                Height="28"
                Margin="0"
                VerticalAlignment="Center"
                ToolTip="Next track"
                Click="TaskbarNextButton_Click">
            <Viewbox Width="14"
                    Height="14"
                    Stretch="Uniform">
                <Canvas Width="16" Height="16">
                    <Path Fill="{Binding Foreground,
                        RelativeSource={RelativeSource AncestorType=Button}}"
                        Data="M 11,3 L 13,3 L 13,13 L 11,13 Z M 3,3 L 11,8 L 3,13 Z"/>
                </Canvas>
            </Viewbox>
        </Button>
    </StackPanel>


            <!-- Album cover with existing track-switch animation -->
            <Border x:Name="AlbumCoverContainer"
                    Width="24"
                    Height="24"
                    CornerRadius="5"
                    Margin="0,0,7,0"
                    ClipToBounds="True"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="AlbumCoverScale"
                                    ScaleX="1.0"
                                    ScaleY="1.0"/>
                </Border.RenderTransform>

                <Image x:Name="MiniAlbumCover"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <!-- Scrolling track title -->
            <Canvas x:Name="TitleCanvas"
                    Width="105"
                    Height="18"
                    ClipToBounds="True"
                    Margin="0,0,8,0">

                <TextBlock x:Name="MiniTrackTitle"
                           Foreground="#EEFFFFFF"
                           FontSize="12"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           Canvas.Left="0"
                           Canvas.Top="0"
                           VerticalAlignment="Center">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="TitleTranslate"
                                            Y="0"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Canvas>

            <!-- Visualizer: bars, fluid wave, and peak caps -->
            <Grid x:Name="VisualizerContainer"
                  Width="94"
                  Height="26"
                  IsHitTestVisible="False">

                <StackPanel x:Name="BarsPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                <Canvas x:Name="FluidWaveCanvas"
                        Width="94"
                        Height="26"
                        IsHitTestVisible="False"/>

                <Canvas x:Name="PeakCapsCanvas"
                        Width="94"
                        Height="26"
                        IsHitTestVisible="False"/>
            </Grid>

        </StackPanel>
    </Grid>
</Window>
