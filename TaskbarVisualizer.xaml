<Window x:Class="DanzFlyout.TaskbarVisualizer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DanzFlyout Visualizer"
        Height="40"
        Width="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Grid Background="Transparent">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0">
            
            <!-- Mini Album Cover with Scale Transform for Track Switch Pop -->
            <Border x:Name="AlbumCoverContainer"
                    Width="24" 
                    Height="24" 
                    CornerRadius="5" 
                    Margin="0,0,7,0" 
                    ClipToBounds="True"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="AlbumCoverScale" ScaleX="1.0" ScaleY="1.0"/>
                </Border.RenderTransform>
                <Image x:Name="MiniAlbumCover" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <!-- Marquee Track Title with Slide-Up Transform -->
            <Canvas x:Name="TitleCanvas" Width="105" Height="18" ClipToBounds="True" Margin="0,0,8,0">
                <TextBlock x:Name="MiniTrackTitle"
                           Foreground="#EEFFFFFF"
                           FontSize="12"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           Canvas.Left="0"
                           Canvas.Top="0"
                           VerticalAlignment="Center">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="TitleTranslate" Y="0"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Canvas>

            <!-- Equalizer Container (Compact 94px) -->
            <Grid Width="94" Height="26" IsHitTestVisible="False">
                <StackPanel x:Name="BarsPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                <Canvas x:Name="FluidWaveCanvas"
                        Width="94"
                        Height="26"
                        IsHitTestVisible="False"/>

                <Canvas x:Name="PeakCapsCanvas"
                        Width="94"
                        Height="26"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>